# Copy to .env.local and fill in with values from the Supabase project
# (Settings -> API). SUPABASE_SERVICE_ROLE_KEY is server-only, used by the
# seed script and admin routes — never expose it to the browser.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Management API token — only needed to apply migrations via the API
# (see CLAUDE.md "Supabase specifics").
SUPABASE_ACCESS_TOKEN=

# Anthropic API key for the Mockup Navigator "Summarize Next Steps" feature
# (server-only). Use a workspace-scoped key, or an org key plus
# ANTHROPIC_WORKSPACE_ID.
ANTHROPIC_API_KEY=
# ANTHROPIC_WORKSPACE_ID=
